# Tareas programadas de Mine Sentinel. Instalar con: crontab -e  (y pegar estas líneas)
# Ajustar RUTA al directorio MineSentinel-main y cargar las variables DB_* desde un archivo seguro.
# Crear antes la carpeta de logs: mkdir -p $RUTA/logs
RUTA=/opt/minesentinel/MineSentinel-main
MAILTO=""

# Respaldo diario de BD + evidencias a las 02:00
0 2 * * *   cd $RUTA && . ./scripts/minesentinel.env && ./scripts/backup_bd.sh >> logs/mantenimiento.log 2>&1
# Limpieza semanal de evidencias antiguas (domingo 03:00, después del respaldo)
0 3 * * 0   cd $RUTA && . ./scripts/minesentinel.env && ./scripts/limpiar_evidencias.sh >> logs/mantenimiento.log 2>&1
# Verificación de backend y cliente de visión cada 5 minutos
*/5 * * * * cd $RUTA && ./scripts/verificar_servicio.sh >> logs/monitoreo.log 2>&1
